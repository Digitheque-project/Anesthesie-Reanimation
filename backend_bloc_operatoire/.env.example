# Toutes les URL ci-dessous sont des racines nues (schéma + hôte, sans chemin, sans slash final) —
# ex. https://mon-service.onrender.com — jamais "https://mon-service.onrender.com/api/...". Le
# préfixe/suffixe propre à chaque service est géré côté code (voir src/external/*.client.ts).

# Base de données
DATABASE_URL=

# Identité de ce service au sein de la plateforme
CHU_ID=
SERVICE_ID=

# Authentification centrale (SSO)
JWT_SECRET=
JWT_EXPIRATION=
CENTRAL_AUTH_JWT_SECRET=
CENTRAL_AUTH_SERVICE_URL=
CENTRAL_CHU_SERVICE_URL=
CENTRAL_LOGIN_URL=
CENTRAL_SERVICE_REGISTRY_URL=
CENTRAL_USER_SERVICE_URL=

# CORS
CORS_ORIGINS=

# Services externes de la plateforme (racine nue uniquement, voir note en haut de fichier)
ACCUEIL_API_URL=
DOSSIER_PATIENT_API_URL=
ENDOSCOPIE_API_URL=
ENDOSCOPIE_SERVICE_ID=
NOTIFICATION_API_URL=
NOTIFICATION_ORIGINE_URL=
PHARMACIE_API_URL=
PRESCRIPTION_API_URL=
PRESCRIPTION_IMAGERIE_API_URL=
SERVICE_CHU_API_URL=
