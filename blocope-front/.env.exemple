# Sauf mention contraire, toutes les URL ci-dessous sont des racines nues (schéma + hôte, sans
# chemin, sans slash final) — ex. https://mon-service.onrender.com — jamais
# "https://mon-service.onrender.com/api/...". Le préfixe/suffixe propre à chaque service est géré
# côté code (voir lib/api/client.ts, lib/clinical/*.ts, lib/notifications/socket.ts).

# --- Variables NEXT_PUBLIC_* : figées dans le bundle au build (voir Dockerfile, --build-arg) ---

# Ce backend (bloc opératoire) — lib/api/client.ts y ajoute lui-même /bloc/api.
NEXT_PUBLIC_API_URL=

# Identifiant de ce service au sein de la plateforme (pas une URL).
NEXT_PUBLIC_SERVICE_ID=

# Page de connexion du SSO central — URL COMPLÈTE (pas une racine nue), utilisée telle quelle
# comme cible de redirection du navigateur. Ex. https://auth-client.example.com/login
NEXT_PUBLIC_CENTRAL_LOGIN_URL=

# Service de notifications externe (WebSocket) — lib/notifications/socket.ts y ajoute /notifications.
NEXT_PUBLIC_NOTIFICATION_WS_URL=

# Service Dossier Patient — chaque appel ajoute son propre chemin (/sorties-medicales, etc.).
NEXT_PUBLIC_DOSSIER_PATIENT_API_URL=

# Service Hospitalisation (plan de lits, épisodes) — lib/clinical/hospitalisation-api.ts y ajoute /clinique.
NEXT_PUBLIC_HOSPITALISATION_API_URL=

# Service Prescription — features/prescription/lib/api.ts y ajoute /prescriptions.
NEXT_PUBLIC_PRESCRIPTION_API_URL=

# Service Prise en charge — lib/clinical/prise-en-charge-api.ts y ajoute /{id}.
NEXT_PUBLIC_PRISE_EN_CHARGE_API_URL=

# Service Upload de fichiers — lib/clinical/upload-api.ts y ajoute /files.
NEXT_PUBLIC_UPLOAD_API_URL=

# ⚠️ EXCEPTION — pas une racine nue : lib/clinical/service-chu-api.ts appelle cette URL avec un
# chemin vide (le chemin complet de l'endpoint doit donc déjà être dans la valeur). Non harmonisé
# avec les autres variables de ce fichier ; à corriger séparément si besoin.
NEXT_PUBLIC_SERVICE_CHU_API_BASE_URL=

# --- Variables serveur uniquement (lues à l'exécution, jamais figées au build) ---
# Utilisées par les routes API internes qui proxifient ces services pour éviter le CORS
# (app/api/accueil/*, app/api/users/*) — voir docker-compose.yml.

ACCUEIL_API_URL=
USER_SERVICE_API_URL=
